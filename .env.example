# ==============================================================================
# Multi-Agent AI Verification Platform - Environment Variables
# 100% Free-Tier Configuration
# ==============================================================================

# Primary Ultra-Fast LLM (Get your free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Adversarial Critic / Secondary LLM (Get your free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Models
PRIMARY_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant
CRITIC_MODEL=gemini-2.0-flash

# Maximum Re-verification & Correction loops (prevents runaway cycles)
MAX_VERIFICATION_LOOPS=3

# Server Settings
PORT=8000
HOST=0.0.0.0
